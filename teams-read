#!/usr/bin/env python3
"""Read-only Teams commands using Microsoft 365 CLI."""
import argparse
import json
import os
from pathlib import Path
import subprocess
import sys

ROOT = Path.home() / '.local/share/teams-reader'
CLI = ROOT / 'node_modules/.bin/m365'
CONFIG = ROOT / 'account.json'


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='command', required=True)
    sub.add_parser('status', help='Show authentication status')
    sub.add_parser('login', help='Sign in interactively using a device code')
    sub.add_parser('logout', help='Remove this reader session')
    sub.add_parser('chats', help='List your existing chats')
    sub.add_parser('teams', help='List teams you belong to')
    messages = sub.add_parser('messages', help='Read messages in a chat')
    messages.add_argument('chat_id')
    channels = sub.add_parser('channels', help='List channels in a team')
    channels.add_argument('team_id')
    posts = sub.add_parser('posts', help='Read channel posts')
    posts.add_argument('team_id')
    posts.add_argument('channel_id')
    replies = sub.add_parser('replies', help='Read replies to a channel post')
    replies.add_argument('team_id')
    replies.add_argument('channel_id')
    replies.add_argument('message_id')
    args = parser.parse_args()
    os.umask(0o077)
    if args.command == 'login':
        if not CONFIG.exists():
            parser.exit(2, 'Setup incomplete: account.json needs the dedicated Entra appId and tenant.\n')
        config = json.loads(CONFIG.read_text())
        command = ['login', '--authType', 'deviceCode', '--appId', config['appId'],
                   '--tenant', config['tenant'], '--connectionName', 'teams-reader']
    elif args.command in ('status', 'logout'):
        command = [args.command]
    elif args.command == 'chats':
        command = ['teams', 'chat', 'list']
    elif args.command == 'messages':
        command = ['teams', 'chat', 'message', 'list', '--chatId', args.chat_id]
    elif args.command == 'channels':
        command = ['teams', 'channel', 'list', '--teamId', args.team_id]
    elif args.command == 'posts':
        command = ['teams', 'message', 'list', '--teamId', args.team_id,
                   '--channelId', args.channel_id]
    elif args.command == 'teams':
        command = ['teams', 'team', 'list', '--joined']
    else:
        command = ['teams', 'message', 'reply', 'list', '--teamId', args.team_id,
                   '--channelId', args.channel_id, '--messageId', args.message_id]
    return subprocess.call([str(CLI), *command, '--output', 'json'])


if __name__ == '__main__':
    sys.exit(main())
